# DevPortal IA — Secrets
# Copy to .env and fill in values for your chosen adapters.
# Only the variables for your selected adapters are required.
# NEVER commit this file. It is gitignored.

# ──────────────────────────────────────────────────────────────
# LLM Provider (adapters.llm)
# ──────────────────────────────────────────────────────────────

# azure-openai: Azure OpenAI Service
# Obtain from: Azure Portal > Cognitive Services > Keys and Endpoint
# Scopes: Cognitive Services OpenAI User
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_DEPLOYMENT=                 # deployment name, not model name

# openai: OpenAI platform
# Obtain from: https://platform.openai.com/api-keys
# Scopes: model:read, model:write (or default)
# OPENAI_API_KEY=sk-...

# anthropic: Anthropic
# Obtain from: https://console.anthropic.com/settings/keys
# Scopes: default (all models)
# ANTHROPIC_API_KEY=sk-ant-...

# ollama: local Ollama server (no key needed)
# OLLAMA_BASE_URL=http://localhost:11434

# mock: no credentials needed.

# ──────────────────────────────────────────────────────────────
# Git Provider (adapters.git)
# ──────────────────────────────────────────────────────────────

# github: GitHub personal access token or app installation token
# Obtain from: https://github.com/settings/tokens
# Minimum scopes: repo (read/write), pull_request (write)
# GIT_TOKEN=ghp_...

# gitlab: GitLab personal access token
# Obtain from: https://gitlab.com/-/user_settings/personal_access_tokens
# Minimum scopes: api
# GIT_TOKEN=glpat-...

# gitea: Gitea access token
# Obtain from: <gitea-url>/user/settings/applications
# Minimum scopes: repo (read/write), issue (write)
# GIT_TOKEN=

# ──────────────────────────────────────────────────────────────
# Notifier (adapters.notifier)
# ──────────────────────────────────────────────────────────────

# teams: Microsoft Teams incoming webhook
# Obtain from: Teams channel > Connectors > Incoming Webhook
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# slack: Slack incoming webhook or bot token
# Obtain from: https://api.slack.com/apps > Incoming Webhooks
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# or
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL=#devportal

# email: SMTP credentials
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=devportal@example.com
# SMTP_TO=team@example.com

# console: no credentials needed.

# ──────────────────────────────────────────────────────────────
# Identity (adapters.identity)
# ──────────────────────────────────────────────────────────────

# entra-group: Microsoft Entra ID (Azure AD)
# Obtain from: Azure Portal > App Registrations > Certificates & secrets
# Minimum scopes: GroupMember.Read.All (application)
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=

# oidc-group: Generic OIDC provider
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# static-user: no credentials needed. Uses config-based group mapping.

# ──────────────────────────────────────────────────────────────
# n8n
# ──────────────────────────────────────────────────────────────
# N8N_ENCRYPTION_KEY=         # generate with: openssl rand -hex 32
# N8N_WEBHOOK_URL=http://localhost:5678

# ──────────────────────────────────────────────────────────────
# ArgoCD
# ──────────────────────────────────────────────────────────────
# ARGOCD_AUTH_TOKEN=           # argocd account generate-token --account devportal
# ARGOCD_SERVER=localhost:8080
