{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devaiportal.io/schemas/environment/v1",
  "title": "EnvironmentValues",
  "description": "Values schema for the environment Helm blueprint. The request file IS the values file.",
  "type": "object",
  "required": [
    "name",
    "blueprint",
    "owner",
    "team",
    "size",
    "image",
    "expiresAt",
    "requestId"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{1,38}[a-z0-9])?$",
      "description": "DNS-1123 compliant environment name (3-40 chars)"
    },
    "blueprint": {
      "type": "string",
      "enum": ["web", "internal-service", "batch"],
      "description": "Workload blueprint profile"
    },
    "owner": {
      "type": "string",
      "format": "email",
      "description": "Email address of the requesting developer"
    },
    "team": {
      "type": "string",
      "pattern": "^[a-z0-9]([-a-z0-9]{1,28}[a-z0-9])?$",
      "description": "Team identifier for isolation and RBAC binding"
    },
    "size": {
      "type": "string",
      "enum": ["small", "medium", "large"],
      "description": "Resource tier (mapped by platform.yaml)"
    },
    "image": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*(?::[a-zA-Z0-9_.-]+)?$",
      "description": "Container image. Tag must not be latest."
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339 UTC expiration timestamp set by n8n orchestrator"
    },
    "requestId": {
      "type": "string",
      "pattern": "^req-[a-z0-9-]+$",
      "description": "Idempotent request tracking identifier"
    },
    "port": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535,
      "description": "Workload listening port (must be non-privileged >= 1024)"
    },
    "ingress": {
      "type": "boolean",
      "description": "Whether to expose via Ingress (web blueprint only)"
    },
    "schedule": {
      "type": "string",
      "pattern": "^(@(annually|yearly|monthly|weekly|daily|hourly|reboot))|(@every (\\d+(ns|us|µs|ms|s|m|h))+)|([0-9*,/-]+ [0-9*,/-]+ [0-9*,/-]+ [0-9*,/-]+ [0-9*,/-]+)$",
      "description": "Standard 5-field cron expression for batch workloads"
    },
    "command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Entrypoint command for batch workloads"
    },
    "internetEgress": {
      "type": "boolean",
      "default": false,
      "description": "Allow outbound HTTPS traffic to public internet"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "blueprint": { "const": "web" } }
      },
      "then": {
        "required": ["port"]
      }
    },
    {
      "if": {
        "properties": { "blueprint": { "const": "internal-service" } }
      },
      "then": {
        "required": ["port"],
        "not": {
          "properties": {
            "ingress": { "const": true }
          },
          "required": ["ingress"]
        }
      }
    },
    {
      "if": {
        "properties": { "blueprint": { "const": "batch" } }
      },
      "then": {
        "required": ["schedule", "command"]
      }
    }
  ]
}
